extends layout

block content
  div.container-fluid
    div.row
      div.col-12
        div.d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-center.mb-4.gap-3
          div
            h1.fs-3.mb-1 Documentation
            p This documentation will guide you through the setup and usage of the InApp Inventory Dashboard template.

    div.row
      div.col-12
        div.mb-4
          div.mb-2
            h2.h5.mb-1 Prerequisites
            p Before you begin, ensure you have the following installed:
          ul.list-group.list-group-flush
            li.list-group-item.ps-0 Node.js (v14 or higher)
            li.list-group-item.ps-0 npm or yarn package manager
            li.list-group-item.ps-0 [Any other specific tools/dependencies]

        div.mb-4
          h2.h5.mb-2 Installation
          ol.list-group.list-group-numbered.list-group-flush
            li.list-group-item.ps-0 Clone the repository or download the template
            li.list-group-item.ps-0 Navigate to the project directory
            li.list-group-item.ps-0
              | Install dependencies:
              pre.bg-light.border.rounded.p-3.mt-2
                code npm install

        div.mb-6
          h2.h5.mb-2 Run the app
          p To start the development server:
          pre.bg-light.border.rounded.p-3
            code npm run dev

        div.mb-4
          h2.h5.mb-2 Next Steps
          ol.list-group.list-group-numbered.list-group-flush
            li.list-group-item.ps-0
              | Review the main entry point in&nbsp;
              code src/js/main.js
            li.list-group-item.ps-0 Customize components according to your needs
            li.list-group-item.ps-0
              | Build for production:
              pre.bg-light.border.rounded.p-3.mt-4
                code npm run build

        div.mb-4
          h2.h5.mb-0 Project Structure
          pre
            code.
              inapp/
              ├── src/
              │   ├── assets/         # Static assets
              │   │   ├── images/     # Images
              │   │   ├── js/         # JS
              │   │   ├── scss/       # CSS and styling
              │   └── Pages           # All Pages
              ├── vite.config.js/     # Config Files
              ├── package.json        # Project dependencies
              ├── README.md           # Documentation
              └── .gitignore          # Git ignore file

        div.mb-2
          h2.h5 Support
          p
            | For issues or questions, please refer to the documentation or create an issue in the repository. Also you can contact us at&nbsp;
            a.text-primary(href="#!") CodesCandy
            | .
