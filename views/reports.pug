extends layout

block content
  div.container-fluid
    div.row
      div.col-12
        div.d-flex.justify-content-between.align-items-center.mb-4
          div
            h1.fs-3.mb-1 Reports
            p.mb-0 View your inventory analytics and reports

    //- ── Stat Cards ─────────────────────────────────────────────────────────
    div.row.g-3.mb-3
      div.col-12.col-sm-6.col-md-3
        div.card.h-100
          div.card-body.p-4
            h6.mb-4 Total Revenue
            h3.mb-1.fw-bold= '$' + Number(totalRevenue || 0).toLocaleString('en-US', {minimumFractionDigits: 2})
            p.mb-0.text-success.small
              i.ti.ti-arrow-up
              |  From completed sales
      div.col-12.col-sm-6.col-md-3
        div.card.h-100
          div.card-body.p-4
            h6.mb-4 Products Sold
            h3.mb-1.fw-bold= productsSold || 0
            p.mb-0.text-success.small
              i.ti.ti-arrow-up
              |  Total units sold
      div.col-12.col-sm-6.col-md-3
        div.card.h-100
          div.card-body.p-4
            h6.mb-4 Low Stock Items
            h3.mb-1.fw-bold= lowStock || 0
            p.mb-0.text-warning.small
              i.ti.ti-alert-triangle
              |  Items need restock
      div.col-12.col-sm-6.col-md-3
        div.card.h-100
          div.card-body.p-4
            h6.mb-4 Out of Stock
            h3.mb-1.fw-bold= outOfStock || 0
            p.mb-0.text-danger.small
              i.ti.ti-package-off
              |  Items unavailable

    //- ── Sales Chart Placeholder ────────────────────────────────────────────
    div.row.mb-3
      div.col-12
        div.card
          div.card-body.p-4
            div.d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.mb-3.gap-2
              div
                h2.mb-0.fs-5 Sales Overview
              div.controls
                button#btn-random.btn.btn-light.btn-sm Randomize Data
                button#btn-update.btn.btn-primary.btn-sm Show This Year Only
            div#salesChart
            div.d-flex.justify-content-end
              a.small(href="#") View detailed report

    //- ── Top Products ───────────────────────────────────────────────────────
    div.row
      div.col-12
        div.card
          div.card-body.p-4
            div.d-flex.justify-content-between.align-items-center.mb-3
              div
                h2.mb-0.fs-5 Top Products
            div.list-group.list-group-flush
              if topProducts && topProducts.length
                each p in topProducts
                  div.list-group-item.p-3.d-flex.align-items-center
                    div.me-3
                      img.rounded(src="/assets/images/" + p.image, alt=p.name, style="width:48px; height:48px; object-fit:cover;")
                    div.flex-grow-1
                      div.d-flex.justify-content-between.align-items-center
                        div
                          h6.mb-0= p.name
                          small.text-secondary= p.units_sold + ' units sold'
                        div.text-end
                          strong= '$' + Number(p.revenue).toLocaleString('en-US', {minimumFractionDigits: 2})
              else
                p.text-muted.text-center.py-3 No sales data available yet.
