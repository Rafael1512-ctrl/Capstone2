extends ../layout.pug

block content
  div.container-fluid.px-4.py-4
    div.row.mb-4
      div.col-12
        div.card.border-0.shadow-sm.bg-white.p-4.rounded-3
          div.d-flex.justify-content-between.align-items-center.flex-wrap.gap-3
            div
              h1.h3.fw-bold.text-dark.mb-1 Administrator - Kelola Pengguna
              p.text-muted.mb-0.small Kelola akun pengguna sistem, tetapkan peran (role), dan ubah kredensial akses.
            button.btn.btn-primary.px-4.py-2.d-flex.align-items-center.gap-2.shadow-sm(data-bs-toggle="collapse" data-bs-target="#addUserForm")
              i.ti.ti-user-plus.fs-5
              span.fw-semibold Tambah Pengguna

    //- COLLAPSIBLE FORM
    div#addUserForm.collapse.mb-4
      div.card.border-0.shadow-sm.p-4.rounded-3
        div.border-bottom.pb-3.mb-4
          h5.fw-bold.text-dark.mb-0
            i.ti.ti-user-plus.text-primary.me-2.fs-4
            | Tambah Pengguna Baru
        form(action="/admin/users/create" method="POST")
          div.row.g-3
            div.col-md-3.col-12
              label.form-label.fw-semibold.text-secondary.small Nama Lengkap
              input.form-control.form-control-lg(type="text" name="nama" placeholder="Nama Lengkap" required)
            div.col-md-3.col-12
              label.form-label.fw-semibold.text-secondary.small Email
              input.form-control.form-control-lg(type="email" name="email" placeholder="contoh@mail.com" required)
            div.col-md-3.col-12
              label.form-label.fw-semibold.text-secondary.small Password
              input.form-control.form-control-lg(type="password" name="password" placeholder="Password" required)
            div.col-md-3.col-12
              label.form-label.fw-semibold.text-secondary.small Peran (Role)
              select.form-select.form-select-lg(name="role_id" required)
                each r in roles
                  option(value=r.id)= r.nama.replace('_', ' ').toUpperCase()
          div.mt-4.d-flex.justify-content-end.gap-2
            button.btn.btn-light.px-4(type="button" data-bs-toggle="collapse" data-bs-target="#addUserForm") Batal
            button.btn.btn-primary.px-4(type="submit") Simpan Pengguna

    //- USERS TABLE
    div.row
      div.col-12
        div.card.border-0.shadow-sm.rounded-3.overflow-hidden
          div.card-header.bg-white.py-3.px-4.border-bottom
            h5.fw-bold.text-dark.mb-0 Daftar Pengguna Aktif
          div.table-responsive
            table.table.table-hover.align-middle.mb-0
              thead.table-light.text-secondary.small.text-uppercase.fw-semibold
                tr
                  th.px-4.py-3(style="width: 80px;") ID
                  th.py-3 Nama Lengkap
                  th.py-3 Email
                  th.py-3 Peran (Role)
                  th.text-end.px-4.py-3 Aksi
              tbody.small
                if hasUsers
                  each u in users
                    tr
                      td.px-4.py-3.text-secondary= u.id
                      td.py-3.fw-semibold.text-dark= u.nama
                      td.py-3.text-secondary= u.email
                      td.py-3
                        span.badge.px-3.py-2.rounded-pill(class=(u.role === 'admin' ? 'bg-primary bg-opacity-10 text-primary' : u.role === 'kepala_lab' ? 'bg-success bg-opacity-10 text-success' : u.role === 'ketua_prodi' ? 'bg-warning bg-opacity-10 text-warning' : u.role === 'staf_admin' ? 'bg-info bg-opacity-10 text-info' : 'bg-secondary bg-opacity-10 text-secondary'))
                          = u.role.replace('_', ' ').toUpperCase()
                      td.text-end.px-4.py-3
                        div.d-inline-flex.gap-2
                          button.btn.btn-sm.btn-outline-primary.d-flex.align-items-center.gap-1.px-3(data-bs-toggle="modal" data-bs-target="#editUserModal-" + u.id)
                            i.ti.ti-edit
                            span Edit
                          if u.id !== user.id
                            form.d-inline(action="/admin/users/delete/" + u.id method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus pengguna ini?');")
                              button.btn.btn-sm.btn-outline-danger.d-flex.align-items-center.gap-1.px-3(type="submit")
                                i.ti.ti-trash
                                span Hapus
                          else
                            span.small.text-muted.px-2 (Akun Anda)
                    
                    //- EDIT MODAL FOR THIS USER
                    div.modal.fade(id="editUserModal-" + u.id, tabindex="-1", aria-hidden="true")
                      div.modal-dialog.modal-dialog-centered
                        div.modal-content.border-0.shadow-lg.rounded-3
                          div.modal-header.border-bottom.bg-light
                            h5.modal-title.fw-bold.text-dark
                              i.ti.ti-edit.text-primary.me-2
                              | Edit Data Pengguna
                            button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
                          form(action="/admin/users/edit/" + u.id method="POST")
                            div.modal-body.p-4
                              div.mb-3
                                label.form-label.fw-semibold.text-secondary.small Nama Lengkap
                                input.form-control.form-control-lg(type="text" name="nama" value=u.nama required)
                              div.mb-3
                                label.form-label.fw-semibold.text-secondary.small Email
                                input.form-control.form-control-lg(type="email" name="email" value=u.email required)
                              div.mb-3
                                label.form-label.fw-semibold.text-secondary.small Password Baru (Kosongkan jika tidak ingin diubah)
                                input.form-control.form-control-lg(type="password" name="password" placeholder="Password baru (opsional)")
                              div.mb-3
                                label.form-label.fw-semibold.text-secondary.small Peran (Role)
                                select.form-select.form-select-lg(name="role_id" required)
                                  each r in roles
                                    option(value=r.id selected=(r.id === u.role_id))= r.nama.replace('_', ' ').toUpperCase()
                            div.modal-footer.border-top.bg-light
                              button.btn.btn-light.px-4(type="button" data-bs-dismiss="modal") Batal
                              button.btn.btn-primary.px-4(type="submit") Simpan Perubahan
                else
                  tr
                    td.text-center.py-5.text-muted(colspan="5")
                      i.ti.ti-user-off.fs-1.d-block.mb-2
                      | Tidak ada data pengguna.

