extends ../layout.pug

block content
  div.container-fluid
    div.row
      div.col-12
        div.mb-6
          h1.fs-3.mb-1 Staf Laboratorium - Log Maintenance & Kondisi Inventaris
          p.text-muted Catat pemeliharaan aset inventaris laboratorium secara rutin. Stok BHP yang digunakan akan terpotong secara otomatis oleh sistem.

    div.row.g-4
      //- LOG NEW MAINTENANCE FORM
      div.col-lg-4.col-12
        div.card
          div.card-header.bg-transparent.px-4.py-3.border-bottom
            h5.mb-0 Catat Maintenance Baru
          div.card-body.p-4
            form(action="/staf-lab/maintenance/create" method="POST")
              div.mb-3
                label.form-label Pilih Barang Aset / Inventaris
                select.form-select(name="inventaris_id" required)
                  each inv in inventaris
                    option(value=inv.id)= inv.kode_inventaris + ' - ' + inv.nama_barang
              div.mb-3
                label.form-label Deskripsi / Detail Pemeliharaan
                textarea.form-control(name="deskripsi" rows="3" placeholder="cth. Pembersihan debu kipas angin dan re-pasta processor." required)
              div.mb-3
                label.form-label Status Akhir Kondisi Barang
                select.form-select(name="status_akhir" required)
                  option(value="baik") Baik (Siap Digunakan)
                  option(value="perlu_perbaikan") Perlu Perbaikan
                  option(value="rusak") Rusak (Tidak Dapat Digunakan)
              hr
              div.mb-3
                label.form-label.fw-semibold Gunakan Bahan Habis Pakai (BHP)?
                select.form-select(name="bhp_id_used")
                  option(value="") -- Tidak Menggunakan BHP --
                  each bhp in bhpList
                    option(value=bhp.id)= bhp.nama_bhp + ' (Stok: ' + bhp.stok + ')'
              div.mb-3
                label.form-label Jumlah BHP yang Digunakan
                input.form-control(type="number" name="qty_bhp_used" placeholder="0" min="0")
                small.text-muted.form-text Kosongkan atau isi 0 jika tidak menggunakan BHP.
              button.btn.btn-primary.w-100.mt-2(type="submit") Simpan Log Maintenance

      //- LOGS LIST TABLE
      div.col-lg-8.col-12
        div.card
          div.card-header.bg-transparent.px-4.py-3.border-bottom
            h5.mb-0 Riwayat Pemeliharaan Laboratorium
          div.table-responsive.p-0
            table.table.align-items-center.mb-0.table-hover
              thead.table-light
                tr
                  th.px-4.py-3 Tanggal
                  th Aset / Label
                  th Petugas
                  th Deskripsi Pemeliharaan
                  th Penggunaan BHP
              tbody
                if logs && logs.length
                  each log in logs
                    tr
                      td.px-4.py-3= new Date(log.tanggal_maintenance).toLocaleDateString('id-ID', {day: 'numeric', month: 'short', year: 'numeric'})
                      td
                        div.fw-semibold= log.kode_inventaris
                      td= log.petugas
                      td= log.deskripsi
                      td
                        if log.nama_bhp
                          span.badge.bg-warning-subtle.text-warning-emphasis= log.qty_bhp_used + ' ' + log.nama_bhp
                        else
                          span.text-muted -
                else
                  tr
                    td.text-center.py-5.text-muted(colspan="5") Belum ada riwayat pemeliharaan dicatat.
