doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    title #{title ? title + ' - InApp Inventory Dashboard' : 'InApp Inventory Dashboard'}
    meta(name="viewport", content="width=device-width, initial-scale=1")
    link(rel="apple-touch-icon", sizes="180x180", href="/assets/images/favicon_io/apple-touch-icon.png")
    link(rel="icon", type="image/png", sizes="32x32", href="/assets/images/favicon_io/favicon-32x32.png")
    link(rel="icon", type="image/png", sizes="16x16", href="/assets/images/favicon_io/favicon-16x16.png")
    link(rel="manifest", href="/assets/images/favicon_io/site.webmanifest")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css")
    link(rel="stylesheet", href="/assets/css/style.css")
    script(type="importmap").
      {
        "imports": {
          "bootstrap": "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js",
          "apexcharts": "https://cdn.jsdelivr.net/npm/apexcharts@3.46.0/dist/apexcharts.esm.js"
        }
      }
  body
    // TOPBAR
    nav#topbar.navbar.bg-white.border-bottom.fixed-top.topbar.px-3
      button#toggleBtn.d-none.d-lg-inline-flex.btn.btn-light.btn-icon.btn-sm
        i.ti.ti-layout-sidebar-left-expand
      // MOBILE
      button#mobileBtn.btn.btn-light.btn-icon.btn-sm.d-lg-none.me-2
        i.ti.ti-layout-sidebar-left-expand
      div
        ul.list-unstyled.d-flex.align-items-center.mb-0.gap-1
          // Bell icon
          li
            a.position-relative.btn-icon.btn-sm.btn-light.btn.rounded-circle(data-bs-toggle="dropdown", aria-expanded="false", href="#", role="button")
              svg.icon.icon-tabler.icons-tabler-outline.icon-tabler-bell(xmlns="http://www.w3.org/2000/svg", width="20", height="20", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.5", stroke-linecap="round", stroke-linejoin="round")
                path(stroke="none", d="M0 0h24v24H0z", fill="none")
                path(d="M10 5a2 2 0 1 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3h-16a4 4 0 0 0 2 -3v-3a7 7 0 0 1 4 -6")
                path(d="M9 17v1a3 3 0 0 0 6 0v-1")
              span.position-absolute.top-0.start-100.translate-middle.badge.rounded-pill.bg-danger.mt-2.ms-n2 2
                span.visually-hidden unread messages
            div.dropdown-menu.dropdown-menu-end.dropdown-menu-md.p-0
              ul.list-unstyled.p-0.m-0
                li.p-3.border-bottom
                  div.d-flex.gap-3
                    img.avatar.avatar-sm.rounded-circle(src="/assets/images/avatar/avatar-1.jpg", alt="")
                    div.flex-grow-1.small
                      p.mb-0 New order received
                      p.mb-1 Order #12345 has been placed
                      div.text-secondary 5 minutes ago
                li.p-3.border-bottom
                  div.d-flex.gap-3
                    img.avatar.avatar-sm.rounded-circle(src="/assets/images/avatar/avatar-4.jpg", alt="")
                    div.flex-grow-1.small
                      p.mb-0 New user registered
                      p.mb-1 User @john_doe has signed up
                      div.text-secondary 30 minutes ago
                li.p-3.border-bottom
                  div.d-flex.gap-3
                    img.avatar.avatar-sm.rounded-circle(src="/assets/images/avatar/avatar-2.jpg", alt="")
                    div.flex-grow-1.small
                      p.mb-0 Payment confirmed
                      p.mb-1 Payment of $299 has been received
                      div.text-secondary 1 hour ago
                li.px-4.py-3.text-center
                  a.text-primary(href="#") View all notifications
          // Dropdown
          li.ms-3.dropdown
            a(href="#", role="button", data-bs-toggle="dropdown", aria-expanded="false")
              img.avatar.avatar-sm.rounded-circle(src="/assets/images/avatar/avatar-1.jpg", alt="")
            div.dropdown-menu.dropdown-menu-end.p-0(style="min-width: 200px;")
              div
                div.d-flex.gap-3.align-items-center.border-dashed.border-bottom.px-3.py-3
                  img.avatar.avatar-md.rounded-circle(src="/assets/images/avatar/avatar-1.jpg", alt="")
                  div
                    h4.mb-0.small= user ? user.nama : 'Guest'
                    p.mb-0.small.text-capitalize= user ? user.role.replace('_', ' ') : 'Visitor'
                div.p-3.d-flex.flex-column.gap-1.small.lh-lg
                  a(href="/") Dashboard
                  if user
                    a.text-danger.fw-semibold(href="/signout") Sign Out
                  else
                    a(href="/signin") Sign In

    // SIDEBAR
    aside#sidebar.sidebar
      div.logo-area
        a.d-inline-flex(href="/")
          img(src="/assets/images/logo-icon.svg", alt="", width="24")
          span.logo-text.ms-2
            img(src="/assets/images/logo.svg", alt="")
      ul.nav.flex-column
        li.px-4.py-2: small.nav-text Main
        li: a.nav-link(class=(activePath === '/' ? 'active' : ''), href="/")
          i.ti.ti-home
          span.nav-text Dashboard

        //- Role-based navigation
        if user
          if user.role === 'admin'
            li.px-4.pt-4.pb-2: small.nav-text Administrator
            li: a.nav-link(class=(activePath === '/admin/users' ? 'active' : ''), href="/admin/users")
              i.ti.ti-users
              span.nav-text Data Pengguna
            li: a.nav-link(class=(activePath === '/admin/ruangan' ? 'active' : ''), href="/admin/ruangan")
              i.ti.ti-map-pin
              span.nav-text Data Ruangan

          else if user.role === 'kepala_lab'
            li.px-4.pt-4.pb-2: small.nav-text Kepala Lab
            li: a.nav-link(class=(activePath === '/kepala-lab/pengadaan' ? 'active' : ''), href="/kepala-lab/pengadaan")
              i.ti.ti-file-plus
              span.nav-text Draf Pengadaan
            li: a.nav-link(class=(activePath === '/kepala-lab/history' ? 'active' : ''), href="/kepala-lab/history")
              i.ti.ti-history
              span.nav-text History Draf

          else if user.role === 'ketua_prodi'
            li.px-4.pt-4.pb-2: small.nav-text Ketua Prodi
            li: a.nav-link(class=(activePath === '/ketua-prodi/review' ? 'active' : ''), href="/ketua-prodi/review")
              i.ti.ti-shield-check
              span.nav-text Review Draf
            li: a.nav-link(class=(activePath === '/ketua-prodi/history' ? 'active' : ''), href="/ketua-prodi/history")
              i.ti.ti-history
              span.nav-text History Finalisasi

          else if user.role === 'staf_admin'
            li.px-4.pt-4.pb-2: small.nav-text Staf Administrasi
            li: a.nav-link(class=(activePath === '/staf-admin/drafts' ? 'active' : ''), href="/staf-admin/drafts")
              i.ti.ti-clipboard-check
              span.nav-text Draf Disetujui
            li: a.nav-link(class=(activePath === '/staf-admin/inventaris' ? 'active' : ''), href="/staf-admin/inventaris")
              i.ti.ti-edit
              span.nav-text Update Inventaris

          else if user.role === 'staf_lab'
            li.px-4.pt-4.pb-2: small.nav-text Staf Laboratorium
            li: a.nav-link(class=(activePath === '/staf-lab/bhp' ? 'active' : ''), href="/staf-lab/bhp")
              i.ti.ti-package
              span.nav-text Stok BHP
            li: a.nav-link(class=(activePath === '/staf-lab/maintenance' ? 'active' : ''), href="/staf-lab/maintenance")
              i.ti.ti-tool
              span.nav-text Log Maintenance

        li.px-4.pt-4.pb-2: small.nav-text General
        li: a.nav-link(class=(activePath === '/inventory' ? 'active' : ''), href="/inventory")
          i.ti.ti-box-seam
          span.nav-text Inventory
        li: a.nav-link(class=(activePath === '/create-product' ? 'active' : ''), href="/create-product")
          i.ti.ti-plus
          span.nav-text Add Product
        li: a.nav-link(class=(activePath === '/reports' ? 'active' : ''), href="/reports")
          i.ti.ti-receipt
          span.nav-text Reports
        li: a.nav-link(class=(activePath === '/docs' ? 'active' : ''), href="/docs")
          i.ti.ti-file-text
          span.nav-text Docs

        li.px-4.pt-4.pb-2: small.nav-text Account
        if user
          li: a.nav-link(href="/signout")
            i.ti.ti-logout
            span.nav-text Sign Out
        else
          li: a.nav-link(class=(activePath === '/signin' ? 'active' : ''), href="/signin")
            i.ti.ti-login
            span.nav-text Log in
          li: a.nav-link(class=(activePath === '/signup' ? 'active' : ''), href="/signup")
            i.ti.ti-user-plus
            span.nav-text Sign up

    // MAIN CONTENT
    main#content.content.py-10
      block content
      div.container-fluid
        div.row
          div.col-12
            footer.text-center.py-2.mt-6.text-secondary
              p.mb-0 Copyright © 2026 InApp Inventory Dashboard. Developed by 
                a.text-primary(href="https://codescandy.com/", target="_blank") CodesCandy
                |  • Distributed by 
                a.text-primary(href="https://themewagon.com/", target="_blank") ThemeWagon

    // Bootstrap JS
    script(src="/assets/js/main.js", type="module")

