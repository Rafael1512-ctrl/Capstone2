extends ../layout.pug

block content
  div.container-fluid
    div.row
      div.col-12
        div.mb-6
          h1.fs-3.mb-1 Ketua Prodi - Review Draf Pengadaan
          p.text-muted Tinjau pengajuan draf pengadaan tahunan dari Kepala Laboratorium. Setujui atau tolak item barang secara mandiri sebelum melakukan finalisasi.

    div.row
      div.col-12
        div.card
          div.card-header.bg-transparent.px-4.py-3.border-bottom
            h5.mb-0 Pengajuan Draf Menunggu Review
          div.table-responsive.p-0
            table.table.align-items-center.mb-0.table-hover
              thead.table-light
                tr
                  th.px-4.py-3 ID Draf
                  th Tahun
                  th Pengaju (Kepala Lab)
                  th Total Items
                  th Status Review
                  th Status Draf
                  th.text-end.px-4 Aksi
              tbody
                if drafts && drafts.length
                  each d in drafts
                    tr
                      td.px-4.py-3= '#' + d.id
                      td.fw-semibold= d.tahun
                      td= d.pengaju
                      td= d.total_items + ' items'
                      td
                        if d.pending_items > 0
                          span.text-danger.fw-semibold= d.pending_items + ' Pending Review'
                        else
                          span.text-success.fw-semibold Semua Selesai Direview
                      td
                        span.badge(class=(d.status === 'submitted' ? 'bg-info' : d.status === 'reviewed' ? 'bg-primary' : d.status === 'finalized' ? 'bg-success' : 'bg-secondary'))
                          = d.status.toUpperCase()
                      td.text-end.px-4
                        a.btn.btn-sm.btn-primary(href="/ketua-prodi/review/" + d.id)
                          i.ti.ti-search.me-1
                          | Tinjau Detail
                else
                  tr
                    td.text-center.py-4(colspan="7") Tidak ada draf yang perlu ditinjau.
