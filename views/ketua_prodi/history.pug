extends ../layout.pug

block content
  div.container-fluid
    div.row
      div.col-12
        div.mb-6
          h1.fs-3.mb-1 Ketua Prodi - Riwayat Draf Pengadaan
          p.text-muted Lihat semua draf pengadaan tahunan dari Kepala Laboratorium yang telah Anda setujui (finalisasi) atau tolak.

    div.row
      div.col-12
        div.card
          div.card-header.bg-transparent.px-4.py-3.border-bottom
            h5.mb-0 Riwayat Keputusan Draf
          div.table-responsive.p-0
            table.table.align-items-center.mb-0.table-hover
              thead.table-light
                tr
                  th.px-4.py-3 ID Draf
                  th Tahun
                  th Pengaju (Kepala Lab)
                  th Total Items
                  th Status Draf
                  th Catatan Keputusan
                  th.text-end.px-4 Aksi
              tbody
                if drafts && drafts.length
                  each d in drafts
                    tr
                      td.px-4.py-3= '#' + d.id
                      td.fw-semibold= d.tahun
                      td= d.pengaju
                      td= d.total_items + ' items'
                      td
                        span.badge(class=(d.status === 'finalized' ? 'bg-success' : 'bg-danger'))
                          = d.status === 'finalized' ? 'DISETUJUI' : 'DITOLAK'
                      td
                        if d.alasan_penolakan
                          span.text-muted.small= d.alasan_penolakan
                        else
                          span.text-muted.small -
                      td.text-end.px-4
                        a.btn.btn-sm.btn-outline-primary(href="/ketua-prodi/review/" + d.id)
                          i.ti.ti-search.me-1
                          | Detail
                else
                  tr
                    td.text-center.py-4(colspan="7") Tidak ada riwayat draf pengadaan.
