extends ../layout.pug

block content
  div.container-fluid
    div.row
      div.col-12
        div.mb-6.d-flex.justify-content-between.align-items-center
          div
            h1.fs-3.mb-1 Review Draf Pengadaan ##{draft.id}
            p.text-muted Tinjau item pengadaan untuk Tahun Anggaran #{draft.tahun}. Diajukan oleh: #{draft.pengaju}.
          a.btn.btn-outline-secondary(href="/ketua-prodi/review") Kembali

    div.row.g-3.mb-4
      div.col-12
        div.card
          div.card-body.p-4.d-flex.justify-content-between.align-items-center.bg-light.rounded-2
            div.w-100
              h5.mb-1 Keputusan Draf Pengadaan
              if draft.status !== 'finalized' && draft.status !== 'rejected'
                form(action="/ketua-prodi/review/" + draft.id + "/process" method="POST" onsubmit="return confirm('Apakah Anda yakin dengan keputusan ini?');")
                  div.mb-3
                    label.form-label.fw-bold Catatan / Alasan Penolakan (Opsional jika disetujui)
                    textarea.form-control(name="alasan_penolakan" rows="2" placeholder="Masukkan catatan atau alasan jika menolak...")
                  div.d-flex.gap-2
                    button.btn.btn-success(type="submit" name="action" value="approve")
                      i.ti.ti-check.me-1
                      | Setuju
                    button.btn.btn-danger(type="submit" name="action" value="reject")
                      i.ti.ti-x.me-1
                      | Tolak
              else
                span.badge.fs-6(class=(draft.status === 'finalized' ? 'bg-success' : 'bg-danger'))= draft.status === 'finalized' ? 'APPROVED' : draft.status.toUpperCase()
                if draft.alasan_penolakan
                  div.mt-2.p-2.bg-white.rounded.border
                    strong Catatan Keputusan:
                    p.mb-0.text-muted= draft.alasan_penolakan

    div.row
      div.col-12
        div.card
          div.card-header.bg-transparent.px-4.py-3.border-bottom
            h5.mb-0 Daftar Barang Pengadaan
          div.table-responsive.p-0
            table.table.align-items-center.mb-0
              thead.table-light
                tr
                  th.px-4.py-3 Barang & Rasionalisasi
                  th Tipe
                  th Harga
                  th Qty
                  th Total
                  th Status Item
                  
              tbody
                if items && items.length
                  each item in items
                    tr
                      td.px-4.py-3
                        div.fw-semibold= item.nama_barang
                        div.small.text-muted.mb-1= item.rasionalisasi
                        if item.link_pembelian
                          a.small.text-decoration-underline(href=item.link_pembelian target="_blank") Link Pembelian
                      td.text-capitalize= item.tipe_barang
                      td= '$' + Number(item.harga_satuan).toLocaleString('en-US')
                      td= item.jumlah
                      td.fw-semibold= '$' + Number(item.harga_satuan * item.jumlah).toLocaleString('en-US')
                      td
                        span.badge(class=(item.status_item === 'approved' ? 'bg-success' : item.status_item === 'rejected' ? 'bg-danger' : 'bg-warning'))
                          = item.status_item.toUpperCase()
                      
                else
                  tr
                    td.text-center.py-4(colspan="6") Tidak ada barang pengadaan.
