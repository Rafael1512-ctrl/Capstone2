extends layout.pug

block content
  div.container-fluid
    div.row
      div.col-12
        div.d-flex.justify-content-between.align-items-center.mb-4
          div
            h1.fs-3.mb-1 Inventory
            p.mb-0 Manage your product inventory
          div
            a.btn.btn-primary(href="/create-product") Add Product
    div.row
      div.col-12
        div
          div.d-flex.gap-2.mb-3.flex-wrap.justify-content-between
            input.form-control(type="text", placeholder="Search products...", style="max-width: 250px;")
            div.d-flex.gap-2
              button.btn.btn-outline-secondary
                i.ti.ti-filter
                |  Filter
              button.btn.btn-outline-secondary
                i.ti.ti-file-excel
                |  Excel
              button.btn.btn-outline-secondary
                i.ti.ti-file-pdf
                |  PDF
        div.card.table-responsive
          table.table.mb-0.text-nowrap.table-hover
            thead.table-light.border-light
              tr
                th Image
                th Code
                th Category
                th Brand
                th Price
                th Unit
                th Quantity
                th Action
            tbody
              if products && products.length
                each product in products
                  tr.align-middle
                    td
                      a(href="#")
                        img.avatar.avatar-md.rounded(src="/assets/images/" + product.image, alt=product.name)
                        span.ms-3= product.name
                    td= product.code
                    td= product.category
                    td= product.brand
                    td= '$' + Number(product.price).toFixed(2)
                    td= product.unit
                    td
                      if product.quantity <= 5
                        span.badge.bg-danger= product.quantity
                      else if product.quantity <= 10
                        span.badge.bg-warning= product.quantity
                      else
                        = product.quantity
                    td
                      a(href="#"): i.ti.ti-edit
                      a.link-danger.ms-2(href="#"): i.ti.ti-trash
              else
                tr
                  td.text-center.text-muted(colspan="8") No products found.
            tfoot
              tr
                td.border-bottom-0
                  | Showing #{products ? products.length : 0} product(s)
                td.border-bottom-0(colspan="7")
                  nav(aria-label="Page navigation").d-flex.justify-content-end
                    ul.pagination.mb-0
                      li.page-item.disabled: a.page-link(href="#", tabindex="-1") Previous
                      li.page-item.active: a.page-link(href="#") 1
                      li.page-item: a.page-link(href="#") Next
