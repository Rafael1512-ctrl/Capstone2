            tfoot
              tr
                td.border-bottom-0 Showing product per page
                td.border-bottom-0(colspan="7")
                  nav(aria-label="Page navigation").d-flex.justify-content-end
                    ul.pagination.mb-0
                      li.page-item.disabled: a.page-link(href="#", tabindex="-1") Previous
                      li.page-item.active: a.page-link(href="#") 1
                      li.page-item: a.page-link(href="#") 2
                      li.page-item: a.page-link(href="#") 3
                      li.page-item: a.page-link(href="#") Next
