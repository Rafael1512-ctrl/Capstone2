extends layout.pug

block content
  div.container-fluid
    div.row
      div.col-12
        div.d-flex.justify-content-between.align-items-center.mb-4
          div
            h1.fs-3.mb-1 Inventory
            p.mb-0 Manage your product inventory
          div
            a.btn.btn-primary(href="/create-product") Add Product
    div.row
      div.col-12
        div
          div.d-flex.gap-2.mb-3.flex-wrap.justify-content-between
            input.form-control(type="text", placeholder="Search products...", style="max-width: 250px;")
            div.d-flex.gap-2
              button.btn.btn-outline-secondary
                i.ti.ti-filter
                |  Filter
              button.btn.btn-outline-secondary
                i.ti.ti-file-excel
                |  Excel
              button.btn.btn-outline-secondary
                i.ti.ti-file-pdf
                |  PDF
        div.card.table-responsive
          table.table.mb-0.text-nowrap.table-hover
            thead.table-light.border-light
              tr
                th Image
                th Code
                th Category
                th Brand
                th Price
                th Unit
                th Quantity
                th Action
            tbody
              tr.align-middle
                td
                  a(href="#")
                    img.avatar.avatar-md.rounded(src="./assets/images/product-1.png", alt="")
                    span.ms-3 Gaming Joy Stick
                td PRD001
                td Electronics
                td Brand Name
                td $99.99
                td pcs
                td 150
                td
                  a(href="#"): i.ti.ti-edit
                  a.link-danger.ms-2(href="#"): i.ti.ti-trash
              tr.align-middle
                td
                  a(href="#")
                    img.avatar.avatar-md.rounded(src="./assets/images/product-2.png", alt="")
                    span.ms-3 Wireless Earphones
                td PRD002
                td Electronics
                td Tech Pro
                td $89.99
                td pcs
                td 320
                td
                  a(href="#"): i.ti.ti-edit
                  a.link-danger.ms-2(href="#"): i.ti.ti-trash
              tr.align-middle
                td
                  a(href="#")
                    img.avatar.avatar-md.rounded(src="./assets/images/product-3.png", alt="")
                    span.ms-3 Smart Watch Pro
                td PRD003
                td Electronics
                td Tech Pro
                td $98.00
                td pcs
                td 200
                td
                  a(href="#"): i.ti.ti-edit
                  a.link-danger.ms-2(href="#"): i.ti.ti-trash
              tr.align-middle
                td
                  a(href="#")
                    img.avatar.avatar-md.rounded(src="./assets/images/product-4.png", alt="")
                    span.ms-3 USB-C Fast Charger
                td PRD004
                td Electronics
                td Tech Pro
                td $86.00
                td pcs
                td 80
                td
                  a(href="#"): i.ti.ti-edit
                  a.link-danger.ms-2(href="#"): i.ti.ti-trash
              tr.align-middle
                td
                  a(href="#")
                    img.avatar.avatar-md.rounded(src="./assets/images/product-5.png", alt="")
                    span.ms-3 Portable Bluetooth Speaker
                td PRD005
                td Electronics
                td Tech Pro
                td $32.00
                td pcs
                td 110
                td
