extends layout

block content
  div.container-fluid
    div.row
      div.col-12
        div.d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-center.mb-4.gap-3
          div
            h1.fs-3.mb-1 Add Inventory
            p.mb-0 Manage your inventory items
          div
            a.btn.btn-primary(href="/inventory") Go to Inventory List
    div.row
      div.col-12
        div.card
          div.card-body.p-4
            form#addProductForm
              div.row
                div.col-md-6.mb-3
                  label.form-label(for="productName") Product Name
                  input#productName.form-control(type="text", placeholder="Enter product name", required)
                div.col-md-6.mb-3
                  label.form-label(for="productSKU") SKU
                  input#productSKU.form-control(type="text", placeholder="Enter SKU", required)
              div.row
                div.col-md-6.mb-3
                  label.form-label(for="productPrice") Price
                  input#productPrice.form-control(type="number", placeholder="0.00", step="0.01", required)
                div.col-md-6.mb-3
                  label.form-label(for="productStock") Stock Quantity
                  input#productStock.form-control(type="number", placeholder="0", required)
              div.mb-3
                label.form-label(for="productCategory") Category
                select#productCategory.form-select(required)
                  option(value="") Select category
                  option(value="electronics") Electronics
                  option(value="clothing") Clothing
                  option(value="food") Food
              div.mb-3
                label.form-label(for="productImage") Product Image
                input#productImage.form-control(type="file", accept="image/*", required)
              div.mb-3
                label.form-label(for="productDescription") Description
                textarea#productDescription.form-control(rows="4", placeholder="Enter product description")
              div.d-flex.gap-2
                button.btn.btn-primary(type="submit") Add Product
                button.btn.btn-secondary(type="reset") Clear
