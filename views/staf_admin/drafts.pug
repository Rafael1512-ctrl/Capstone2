extends ../layout.pug

block content
  div.container-fluid
    div.row
      div.col-12
        div.mb-6
          h1.fs-3.mb-1 Staf Administrasi - Draf Pengadaan Disetujui
          p.text-muted Tinjau daftar draf pengadaan barang tahunan yang telah lolos review dan disetujui (finalized) oleh Ketua Program Studi.

    div.row
      div.col-12
        div.card
          div.card-header.bg-transparent.px-4.py-3.border-bottom
            h5.mb-0 Daftar Pengadaan Finalized
          div.table-responsive.p-0
            table.table.align-items-center.mb-0.table-hover
              thead.table-light
                tr
                  th.px-4.py-3 ID Draf
                  th Tahun Anggaran
                  th Pengaju (Kepala Lab)
                  th Jumlah Barang Disetujui
                  th Status Draf
                  th.text-end.px-4 Aksi
              tbody
                if drafts && drafts.length
                  each d in drafts
                    tr
                      td.px-4.py-3= '#' + d.id
                      td.fw-semibold= d.tahun
                      td= d.pengaju
                      td= d.approved_items + ' items disetujui'
                      td
                        span.badge.bg-success FINALIZED
                      td.text-end.px-4
                        a.btn.btn-sm.btn-primary(href="/staf-admin/inventaris")
                          i.ti.ti-edit.me-1
                          | Input Penerimaan & Labeling
                else
                  tr
                    td.text-center.py-4(colspan="6") Belum ada draf pengadaan berstatus finalized untuk diproses.
