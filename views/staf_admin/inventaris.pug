extends ../layout.pug

block content
  div.container-fluid
    div.row
      div.col-12
        div.mb-6
          h1.fs-3.mb-1 Staf Administrasi - Penerimaan & Labeling Inventaris
          p.text-muted Lakukan pencatatan penerimaan barang, penomoran label/kode inventaris, pemetaan ruangan, dan generate QR Code untuk barang inventaris yang telah disetujui.

    //- PENDING ITEMS SECTION
    div.row.mb-4
      div.col-12
        div.card
          div.card-header.bg-warning.bg-opacity-10.border-bottom.px-4.py-3.border-warning.border-opacity-25
            h5.mb-0.text-warning-emphasis Menunggu Penerimaan & Penomoran Label (Barang Approved)
          div.table-responsive.p-0
            table.table.align-items-center.mb-0
              thead.table-light
                tr
                  th.px-4.py-3 Barang (Pengadaan)
                  th Tahun
                  th Qty
                  th Form Labeling & Penerimaan
              tbody
                if pendingItems && pendingItems.length
                  each item in pendingItems
                    tr
                      td.px-4.py-3
                        div.fw-semibold= item.nama_barang
                        small.text-muted= 'Diajukan oleh: ' + item.pengaju
                      td= item.tahun
                      td= item.jumlah
                      td
                        form.row.g-2.align-items-end.py-2(action="/staf-admin/inventaris/receive/" + item.id method="POST")
                          div.col-md-3.col-12
                            label.form-label.small.mb-1 Kode Inventaris / Label
                            input.form-control.form-control-sm(type="text" name="kode_inventaris" placeholder="cth. INV-LAB-01" required)
                          div.col-md-3.col-12
                            label.form-label.small.mb-1 Ruangan Penempatan
                            select.form-select.form-select-sm(name="ruangan_id" required)
                              each r in ruangan
                                option(value=r.id)= r.kode_ruangan + ' - ' + r.nama_ruangan
                          div.col-md-3.col-12
                            label.form-label.small.mb-1 Tgl Penerimaan
                            input.form-control.form-control-sm(type="date" name="tanggal_penerimaan" required)
                          div.col-md-2.col-12
                            label.form-label.small.mb-1 Kondisi Awal
                            select.form-select.form-select-sm(name="status_kondisi")
                              option(value="baik") Baik
                              option(value="perlu_perbaikan") Perlu Perbaikan
                              option(value="rusak") Rusak
                          div.col-md-1.col-12.d-grid
                            button.btn.btn-sm.btn-primary(type="submit")
                              i.ti.ti-check

                else
                  tr
                    td.text-center.py-4.text-muted(colspan="4") Tidak ada barang inventaris pending untuk dilabeli.

    //- RECEIVED ITEMS SECTION
    div.row
      div.col-12
        div.card
          div.card-header.bg-transparent.px-4.py-3.border-bottom
            h5.mb-0 Inventaris Terdaftar & QR-Labeled
          div.table-responsive.p-0
            table.table.align-items-center.mb-0.table-hover
              thead.table-light
                tr
                  th.px-4.py-3 ID
                  th Kode/Label
                  th Nama Barang
                  th Ruangan
                  th Tanggal Terima
                  th Kondisi
                  th.text-end.px-4 QR Code / Barcode
              tbody
                if receivedItems && receivedItems.length
                  each inv in receivedItems
                    tr
                      td.px-4.py-3= inv.id
                      td: span.badge.bg-primary.fs-7= inv.kode_inventaris
                      td.fw-semibold= inv.nama_barang
                      td= inv.nama_ruangan || 'Belum Ditempatkan'
                      td= new Date(inv.tanggal_penerimaan).toLocaleDateString('id-ID', {day: 'numeric', month: 'short', year: 'numeric'})
                      td
                        span.badge(class=(inv.status === 'baik' ? 'bg-success' : inv.status === 'perlu_perbaikan' ? 'bg-warning' : 'bg-danger'))
                          = inv.status.toUpperCase()
                      td.text-end.px-4
                        div.d-inline-flex.align-items-center.gap-2
                          i.ti.ti-qrcode.fs-3.text-secondary
                          span.small.text-muted.font-monospace= inv.foto_qr
                else
                  tr
                    td.text-center.py-4(colspan="7") Belum ada barang inventaris yang dilabeli.
