extends ../layout.pug

block content
  div.container-fluid
    div.row
      div.col-12
        div.mb-6
          h1.fs-3.mb-1 Kepala Lab - Draf Pengadaan Tahunan
          p.text-muted Buat dan kelola pengadaan barang (inventaris & BHP) baru untuk diajukan ke Ketua Program Studi.

    if !hasActiveDraft
      //- NO ACTIVE DRAFT: SHOW CREATE BUTTON
      div.row
        div.col-12.col-md-6.mx-auto
          div.card.text-center.p-5
            div.icon-shape.icon-lg.bg-primary.bg-opacity-10.text-primary.rounded-circle.mx-auto.mb-4
              i.ti.ti-file-plus.fs-3
            h4 Mulai Pengadaan Baru
            p.text-muted Anda belum memiliki draf pengadaan aktif. Masukkan tahun anggaran untuk memulai.
            form(action="/kepala-lab/pengadaan/create-draft" method="POST")
              div.mb-3
                label.form-label Tahun Anggaran
                input.form-control.mx-auto.text-center(type="number" name="tahun" value=new Date().getFullYear() style="max-width:300px;" required)
              div.mb-3
                label.form-label Pilih Ketua Prodi
                select.form-select.mx-auto(name="ketua_prodi_id" style="max-width:300px;" required)
                  option(value="") -- Pilih Kaprodi --
                  if hasKaprodiList
                    each kaprodi in kaprodiList
                      option(value=kaprodi.id)= kaprodi.nama
              button.btn.btn-primary(type="submit") Buat Draf Baru
    else
      //- ACTIVE DRAFT EXISTS
      div.row.g-4
        //- Draft Info & Add Item
        div.col-lg-4.col-12
          div.card.mb-4
            div.card-header.bg-transparent.px-4.py-3.border-bottom
              h5.mb-0 Info Draf Aktif
            div.card-body.p-4
              form(action="/kepala-lab/pengadaan/update-draft/" + activeDraft.id method="POST")
                div.mb-3
                  label.form-label.text-secondary Tahun Anggaran
                  input.form-control.form-control-sm(type="number" name="tahun" value=activeDraft.tahun required)
                div.mb-3
                  label.form-label.text-secondary Pilih Ketua Prodi
                  select.form-select.form-select-sm(name="ketua_prodi_id" required)
                    option(value="") -- Pilih Kaprodi --
                    if hasKaprodiList
                      each kaprodi in kaprodiList
                        option(value=kaprodi.id selected=(activeDraft.ketua_prodi_id == kaprodi.id))= kaprodi.nama
                div.d-flex.justify-content-between.mb-3
                  span.text-secondary Status Draf:
                  span.badge.bg-warning.text-capitalize= activeDraft.status
                div.d-flex.gap-2.mb-3
                  button.btn.btn-sm.btn-primary.flex-grow-1(type="submit") Simpan Draf
              
              form.d-flex.gap-2(action="/kepala-lab/pengadaan/delete-draft/" + activeDraft.id method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus seluruh draf ini beserta isinya?');")
                button.btn.btn-sm.btn-outline-danger.flex-grow-1(type="submit") Hapus Draf
              hr
              form.d-grid(action="/kepala-lab/pengadaan/submit/" + activeDraft.id method="POST" onsubmit="return confirm('Apakah Anda yakin ingin mengirim draf ini? Setelah dikirim draf akan dikunci dan tidak dapat diubah lagi.');")
                button.btn.btn-success(type="submit")
                  i.ti.ti-send.me-1
                  | Kirim ke Kaprodi

          div.card
            div.card-header.bg-transparent.px-4.py-3.border-bottom
              h5.mb-0 Tambah Item ke Draf
            div.card-body.p-4
              form(action="/kepala-lab/pengadaan/add-item" method="POST")
                input(type="hidden" name="draft_id" value=activeDraft.id)
                div.mb-3
                  label.form-label Nama Barang
                  input.form-control(type="text" name="nama_barang" placeholder="cth. Monitor Dell 24 inch" required)
                div.mb-3
                  label.form-label Tipe Barang
                  select.form-select(name="tipe_barang" required)
                    option(value="inventaris") Inventaris (Barang Tetap)
                    option(value="bhp") BHP (Barang Habis Pakai)
                div.mb-3
                  label.form-label Harga Satuan
                  input.form-control(type="number" name="harga_satuan" placeholder="cth. 2500000" required)
                div.mb-3
                  label.form-label Jumlah
                  input.form-control(type="number" name="jumlah" placeholder="cth. 5" min="1" required)
                div.mb-3
                  label.form-label Rasionalisasi Item
                  textarea.form-control(name="rasionalisasi" rows="2" placeholder="Alasan butuh barang ini..." required)
                div.mb-3
                  label.form-label Link Pembelian (Opsional)
                  input.form-control(type="url" name="link_pembelian" placeholder="https://tokopedia.com/...")
                button.btn.btn-primary.w-100(type="submit") Tambah ke Draf

        //- Table of Items
        div.col-lg-8.col-12
          div.card
            div.card-header.bg-transparent.px-4.py-3.border-bottom.d-flex.justify-content-between.align-items-center
              h5.mb-0 Detail Draf Pengadaan
              span.small.text-secondary= itemCount + ' item terdaftar'
            div.table-responsive.p-0
              table.table.align-items-center.mb-0
                thead.table-light
                  tr
                    th Barang & Rasionalisasi
                    th Tipe
                    th Harga
                    th Qty
                    th Total
                    th.text-end.px-4 Aksi
                tbody
                  if hasItems
                    each item in items
                      tr
                        td.px-4.py-3
                          div.fw-semibold= item.nama_barang
                          div.small.text-muted.mb-1= item.rasionalisasi
                          if item.link_pembelian
                            a.small.text-decoration-underline(href=item.link_pembelian target="_blank") Link Pembelian
                        td.text-capitalize= item.tipe_barang
                        td= '$' + Number(item.harga_satuan).toLocaleString('en-US')
                        td= item.jumlah
                        td.fw-semibold= '$' + Number(item.harga_satuan * item.jumlah).toLocaleString('en-US')
                        td.text-end.px-4
                          form.d-inline(action="/kepala-lab/pengadaan/delete-item/" + item.id method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus item ini dari draf?');")
                            button.btn.btn-sm.btn-outline-danger(type="submit")
                              i.ti.ti-trash
                  else
                    tr
                      td.text-center.py-5(colspan="6") Draf ini belum memiliki item pengadaan. Tambah di panel kiri.
