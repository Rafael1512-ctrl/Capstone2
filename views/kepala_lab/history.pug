extends ../layout.pug

block content
  div.container-fluid
    div.row
      div.col-12
        div.mb-6
          h1.fs-3.mb-1 Kepala Lab - Riwayat Pengadaan
          p.text-muted Daftar draf pengadaan tahunan yang sudah Anda ajukan dan status persetujuannya saat ini.

    div.row
      div.col-12
        div.card
          div.card-header.bg-transparent.px-4.py-3.border-bottom
            h5.mb-0 Riwayat Pengajuan
          div.table-responsive.p-0
            table.table.align-items-center.mb-0.table-hover
              thead.table-light
                tr
                  th.px-4.py-3 ID Draf
                  th Tahun Anggaran
                  th Jumlah Item
                  th Status Draf
                  th.text-end.px-4 Detail
              tbody
                if drafts && drafts.length
                  each d in drafts
                    tr
                      td.px-4.py-3= '#' + d.id
                      td.fw-semibold= d.tahun
                      td= d.item_count + ' items'
                      td
                        span.badge(class=(d.status === 'submitted' ? 'bg-info' : d.status === 'reviewed' ? 'bg-primary' : d.status === 'finalized' ? 'bg-success' : 'bg-secondary'))
                          = d.status.toUpperCase()
                      td.text-end.px-4
                        //- Let's link to review detail or just show it's locked.
                        span.small.text-muted Draf Terkunci
                else
                  tr
                    td.text-center.py-4(colspan="5") Belum ada riwayat pengajuan draf.
