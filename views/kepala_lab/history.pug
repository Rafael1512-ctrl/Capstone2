extends ../layout.pug

block content
  div.container-fluid
    div.row
      div.col-12
        div.mb-6
          h1.fs-3.mb-1 Kepala Lab - Riwayat & Kelola Draf
          p.text-muted Kelola item draf pengadaan aktif Anda atau lihat riwayat draf yang sudah dikirim ke Ketua Program Studi.

    
    //- HISTORY SECTION
    div.row
      div.col-12
        div.card
          div.card-header.bg-transparent.px-4.py-3.border-bottom
            h5.mb-0 Riwayat Pengajuan (Draf Terkirim / Selesai)
          div.table-responsive.p-0
            table.table.align-items-center.mb-0.table-hover
              thead.table-light
                tr
                  th.px-4.py-3 ID Draf
                  th Tahun Anggaran
                  th Jumlah Item
                  th Catatan Kaprodi
                  th Status Draf
                  th.text-end.px-4 Detail
              tbody
                if hasDrafts
                  each d in drafts
                    tr
                      td.px-4.py-3= '#' + d.id
                      td.fw-semibold= d.tahun
                      td= d.item_count + ' items'
                      td(style="max-width: 200px; white-space: normal;")
                        if d.alasan_penolakan
                          span.small.text-danger= d.alasan_penolakan
                        else
                          span.text-muted -
                      td
                        span.badge(class=(d.status === 'submitted' ? 'bg-info' : d.status === 'reviewed' ? 'bg-primary' : d.status === 'finalized' ? 'bg-success' : d.status === 'rejected' ? 'bg-danger' : 'bg-secondary'))
                          = d.status.toUpperCase()
                      td.text-end.px-4
                        span.small.text-muted Draf Terkunci
                else
                  tr
                    td.text-center.py-4(colspan="6") Belum ada riwayat pengajuan draf.
