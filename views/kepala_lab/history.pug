extends ../layout.pug

block content
  div.container-fluid
    div.row
      div.col-12
        div.mb-6
          h1.fs-3.mb-1 Kepala Lab - Riwayat & Kelola Draf
          p.text-muted Kelola item draf pengadaan aktif Anda atau lihat riwayat draf yang sudah dikirim ke Ketua Program Studi.

    if hasActiveDraft
      //- ACTIVE DRAFT SECTION
      div.row.mb-5
        div.col-12
          div.card
            div.card-header.bg-transparent.px-4.py-3.border-bottom.d-flex.justify-content-between.align-items-center
              div
                h5.mb-0 Draf Pengadaan Aktif (TA #{activeDraft.tahun})
                span.small.text-muted ID Draf: ##{activeDraft.id}
              div.d-flex.gap-2
                form(action="/kepala-lab/pengadaan/submit/" + activeDraft.id method="POST" onsubmit="return confirm('Apakah Anda yakin ingin mengirim draf ini? Setelah dikirim draf akan dikunci dan tidak dapat diubah lagi.');")
                  button.btn.btn-success.btn-sm(type="submit")
                    i.ti.ti-send.me-1
                    | Kirim ke Kaprodi
                form(action="/kepala-lab/pengadaan/delete-draft/" + activeDraft.id method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus seluruh draf ini beserta isinya?');")
                  button.btn.btn-outline-danger.btn-sm(type="submit")
                    i.ti.ti-trash.me-1
                    | Hapus Draf

            div.card-body.p-4.border-bottom.bg-light-subtle
              h6.fw-bold.mb-3 Tambah Item Baru (Lanskap)
              form(action="/kepala-lab/pengadaan/add-item" method="POST")
                input(type="hidden" name="draft_id" value=activeDraft.id)
                div.row.g-3.mb-3
                  div.col-lg-4.col-md-6.col-12
                    label.form-label Nama Barang
                    input.form-control(type="text" name="nama_barang" placeholder="cth. Monitor Dell 24 inch" required)
                  div.col-lg-3.col-md-6.col-12
                    label.form-label Tipe Barang
                    select.form-select(name="tipe_barang" required)
                      option(value="inventaris") Inventaris (Barang Tetap)
                      option(value="bhp") BHP (Barang Habis Pakai)
                  div.col-lg-3.col-md-6.col-12
                    label.form-label Harga Satuan ($)
                    input.form-control(type="number" name="harga_satuan" placeholder="cth. 250" required)
                  div.col-lg-2.col-md-6.col-12
                    label.form-label Jumlah
                    input.form-control(type="number" name="jumlah" placeholder="cth. 5" min="1" required)
                div.row.g-3.align-items-end
                  div.col-lg-6.col-md-8.col-12
                    label.form-label Rasionalisasi / Alasan Kebutuhan
                    input.form-control(type="text" name="rasionalisasi" placeholder="Mengapa barang ini dibutuhkan..." required)
                  div.col-lg-4.col-md-4.col-12
                    label.form-label Link Pembelian (Opsional)
                    input.form-control(type="url" name="link_pembelian" placeholder="https://tokopedia.com/...")
                  div.col-lg-2.col-md-12.col-12
                    button.btn.btn-primary.w-100(type="submit")
                      i.ti.ti-plus.me-1
                      | Tambah Item

            div.table-responsive.p-0
              table.table.align-items-center.mb-0
                thead.table-light
                  tr
                    th.px-4.py-3 Barang & Rasionalisasi
                    th Tipe
                    th Harga
                    th Qty
                    th Total
                    th.text-end.px-4 Aksi
                tbody
                  if hasItems
                    each item in items
                      tr
                        td.px-4.py-3
                          div.fw-semibold= item.nama_barang
                          div.small.text-muted.mb-1= item.rasionalisasi
                          if item.link_pembelian
                            a.small.text-decoration-underline(href=item.link_pembelian target="_blank") Link Pembelian
                        td.text-capitalize= item.tipe_barang
                        td= '$' + Number(item.harga_satuan).toLocaleString('en-US')
                        td= item.jumlah
                        td.fw-semibold= '$' + Number(item.harga_satuan * item.jumlah).toLocaleString('en-US')
                        td.text-end.px-4
                          form.d-inline(action="/kepala-lab/pengadaan/delete-item/" + item.id method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus item ini dari draf?');")
                            button.btn.btn-sm.btn-outline-danger(type="submit")
                              i.ti.ti-trash
                  else
                    tr
                      td.text-center.py-5.text-muted(colspan="6") Belum ada item di draf ini. Silakan isi form di atas untuk menambahkan.

    //- HISTORY SECTION
    div.row
      div.col-12
        div.card
          div.card-header.bg-transparent.px-4.py-3.border-bottom
            h5.mb-0 Riwayat Pengajuan (Draf Terkirim / Selesai)
          div.table-responsive.p-0
            table.table.align-items-center.mb-0.table-hover
              thead.table-light
                tr
                  th.px-4.py-3 ID Draf
                  th Tahun Anggaran
                  th Jumlah Item
                  th Catatan Kaprodi
                  th Status Draf
                  th.text-end.px-4 Detail
              tbody
                if hasDrafts
                  each d in drafts
                    tr
                      td.px-4.py-3= '#' + d.id
                      td.fw-semibold= d.tahun
                      td= d.item_count + ' items'
                      td(style="max-width: 200px; white-space: normal;")
                        if d.alasan_penolakan
                          span.small.text-danger= d.alasan_penolakan
                        else
                          span.text-muted -
                      td
                        span.badge(class=(d.status === 'submitted' ? 'bg-info' : d.status === 'reviewed' ? 'bg-primary' : d.status === 'finalized' ? 'bg-success' : d.status === 'rejected' ? 'bg-danger' : 'bg-secondary'))
                          = d.status.toUpperCase()
                      td.text-end.px-4
                        span.small.text-muted Draf Terkunci
                else
                  tr
                    td.text-center.py-4(colspan="6") Belum ada riwayat pengajuan draf.
