extends layout.pug

block content
  div.container-fluid
    div.row
      div.col-12
        div.mb-6
          h1.fs-3.mb-1 Dashboard
          p Welcome back! Here's what's happening with your inventory.

    //- ── Stat Cards ────────────────────────────────────────────────────────
    div.row.g-3.mb-3
      div.col-lg-3.col-12
        div.card.p-4.bg-primary.bg-opacity-10.border.border-primary.border-opacity-25.rounded-2
          div.d-flex.gap-3
            div.icon-shape.icon-md.bg-primary.text-white.rounded-2
              i.ti.ti-report-analytics.fs-4
            div
              h2.mb-3.fs-6 Total Sales
              h3.fw-bold.mb-0= '$' + Number(totalSales || 0).toLocaleString('en-US', {minimumFractionDigits: 2})
              p.text-primary.mb-0.small Completed orders
      div.col-lg-3.col-12
        div.card.p-4.bg-success.bg-opacity-10.border.border-success.border-opacity-25.rounded-2
          div.d-flex.gap-3
            div.icon-shape.icon-md.bg-success.text-white.rounded-2
              i.ti.ti-box-seam.fs-4
            div
              h2.mb-3.fs-6 Total Products
              h3.fw-bold.mb-0= totalProducts || 0
              p.text-success.mb-0.small Items in inventory
      div.col-lg-3.col-12
        div.card.p-4.bg-warning.bg-opacity-10.border.border-warning.border-opacity-25.rounded-2
          div.d-flex.gap-3
            div.icon-shape.icon-md.bg-warning.text-white.rounded-2
              i.ti.ti-alert-triangle.fs-4
            div
              h2.mb-3.fs-6 Low Stock
              h3.fw-bold.mb-0= lowStock || 0
              p.text-warning.mb-0.small Items ≤ 10 units
      div.col-lg-3.col-12
        div.card.p-4.bg-danger.bg-opacity-10.border.border-danger.border-opacity-25.rounded-2
          div.d-flex.gap-3
            div.icon-shape.icon-md.bg-danger.text-white.rounded-2
              i.ti.ti-package-off.fs-4
            div
              h2.mb-3.fs-6 Out of Stock
              h3.fw-bold.mb-0= outOfStock || 0
              p.text-danger.mb-0.small Need restock

    //- ── Profit, Refund, Expenses Cards ───────────────────────────────────────
    div.row.g-3.mb-3
      div.col-lg-4.col-12
        div.card
          div.card-body.p-4
            div.d-flex.justify-content-between.border-bottom.pb-5.mb-3
              div
                h3.fw-bold.h4= '$' + Number(totalProfit || 0).toLocaleString('en-US', {minimumFractionDigits: 2})
                span Total Profit
              div
                i.ti.ti-layers-subtract.fs-1.text-primary
            div.d-flex.justify-content-between.align-items-center.small
              div.text-muted
                span.text-success +35%
                |  vs Last Month
              div: a.link-primary.text-decoration-underline(href="/reports") View
      div.col-lg-4.col-12
        div.card
          div.card-body.p-4
            div.d-flex.justify-content-between.border-bottom.pb-5.mb-3
              div
                h3.fw-bold.h4= '$' + Number(totalRefunds || 0).toLocaleString('en-US', {minimumFractionDigits: 2})
                span Total Cancelled / Refunds
              div
                i.ti.ti-credit-card.fs-1.text-danger
            div.d-flex.justify-content-between.align-items-center.small
              div.text-muted
                span.text-danger -20%
                |  vs Last Month
              div: a.link-primary.text-decoration-underline(href="/reports") View
      div.col-lg-4.col-12
        div.card
          div.card-body.p-4
            div.d-flex.justify-content-between.border-bottom.pb-5.mb-3
              div
                h3.fw-bold.h4= '$' + Number(totalExpenses || 0).toLocaleString('en-US', {minimumFractionDigits: 2})
                span Total Expenses
              div
                i.ti.ti-cash-banknote.fs-1.text-warning
            div.d-flex.justify-content-between.align-items-center.small
              div.text-muted
                span.text-warning -20%
                |  vs Last Month
              div: a.link-primary.text-decoration-underline(href="/reports") View

    //- ── Charts Row ──────────────────────────────────────────────────────────
    div.row.g-3.mb-3
      div.col-12.col-lg-6
        div.card
          div.card-header.d-flex.justify-content-between.align-items-center.bg-transparent.px-4.py-3
            h3.h5.mb-0 Sales vs Purchase
            div
              select.form-select.form-select-sm
                option(selected) This Year
                option This Month
                option This Week
          div.card-body.p-4
            #salesPurchaseChart
      div.col-12.col-lg-6
        div.card
          div.card-header.d-flex.justify-content-between.align-items-center.bg-transparent.px-4.py-3
            h3.h5.mb-0 Overall Information
            div
              select.form-select.form-select-sm
                option(selected) Last 6 Months
                option This Month
                option This Week
          div.card-body.p-4
            h3.h6 Customers Overview
            div.row.align-items-center
              div.col-sm-6
                #customerChart
              div.col-sm-6
                div.row
                  div.col-6.border-end
                    div.text-center
                      h2.mb-1 5.5K
                      p.text-success.mb-2 First Time
                      span.badge.bg-success
                        i.ti.ti-arrow-up-left.me-1
                        | 25%
                  div.col-6
                    div.text-center
                      h2.mb-1 3.5K
                      p.text-warning.mb-2 Return
                      span.badge.bg-success.badge-xs.d-inline-flex.align-items-center
                        i.ti.ti-arrow-up-left.me-1
                        | 21%
            div.row.text-center.border-top.mt-4.pt-4
              div.col-4.border-end
                h3.fw-bold.mb-2 6,987
                small.text-secondary Suppliers
              div.col-4.border-end
                h3.fw-bold.mb-2 4,896
                small.text-secondary Customers
              div.col-4
                h3.fw-bold.mb-2 487
                small.text-secondary Orders

    //- ── Bottom Cards ───────────────────────────────────────────────────────
    div.row.g-3
      //- CARD 1 — Top Selling Products
      div.col-lg-4
        div.card.h-100
          div.card-header.bg-white.d-flex.justify-content-between.align-items-center.px-4.py-3
            h4.mb-0.h5 Top Selling Products
            button.btn.btn-sm.btn-outline-secondary
              i.ti.ti-calendar
              |  Today
          ul.list-group.list-group-flush
            if hasTopProducts
              each p in topProducts
                li.list-group-item.d-flex.align-items-center.gap-3
                  img.rounded(src="/assets/images/" + p.image, width="48")
                  div.flex-grow-1
                    p.mb-1= p.name
                    div.d-flex.align-items-center.gap-2.text-muted
                      small.fw-semibold= '$' + Number(p.price).toFixed(2)
                      small •
                      small= p.units_sold + ' Units'
            else
              li.list-group-item.text-muted.text-center No data available

      //- CARD 2 — Low Stock Products
      div.col-lg-4
        div.card.h-100
          div.card-header.bg-white.d-flex.justify-content-between.align-items-center.px-4.py-3
            div.d-flex.align-items-center
              h4.mb-0.h5 Low Stock Products
            a.small.text-primary.text-decoration-underline(href="/inventory") View All
          ul.list-group.list-group-flush
            if hasLowStockProducts
              each p in lowStockProducts
                li.list-group-item.d-flex.align-items-center.gap-3
                  img.rounded(src="/assets/images/" + p.image, width="48")
                  div.flex-grow-1
                    p.mb-1= p.name
                    small= 'ID: #' + p.code
                  div.d-flex.flex-column.gap-0.align-items-center
                    span.fw-semibold.text-danger= p.quantity < 10 ? '0' + p.quantity : p.quantity
                    small.text-muted In Stock
            else
              li.list-group-item.text-muted.text-center All stock levels are good

      //- CARD 3 — Recent Sales
      div.col-lg-4
        div.card.h-100
          div.card-header.bg-white.d-flex.justify-content-between.align-items-center.px-4.py-3
            h4.mb-0.h5 Recent Sales
            button.btn.btn-sm.btn-outline-secondary
              i.ti.ti-calendar-event
              |  Weekly
          ul.list-group.list-group-flush
            if hasRecentSales
              each s in recentSales
                li.list-group-item.d-flex.align-items-center.gap-3
                  img.rounded(src="/assets/images/" + s.image, width="48")
                  div.flex-grow-1
                    p.mb-1= s.name
                    div.d-flex.align-items-center.gap-2.text-muted
                      small.fw-semibold= s.category
                      small •
                      small= '$' + Number(s.total).toFixed(2)
                  - var badgeClass = s.status === 'Completed' ? 'bg-success-subtle text-success' : s.status === 'Processing' ? 'bg-primary-subtle text-primary' : s.status === 'Pending' ? 'bg-warning-subtle text-warning' : 'bg-danger-subtle text-danger'
                  span(class="badge " + badgeClass)= s.status
            else
              li.list-group-item.text-muted.text-center No recent sales
