extends layout.pug

block content
  div.container-fluid
    div.row
      div.col-12
        div.mb-6
          h1.fs-3.mb-1 Dashboard
          p Your main content goes here…
    div.row.g-3.mb-3
      div.col-lg-3.col-12
        div.card.p-4.bg-primary.bg-opacity-10.border.border-primary.border-opacity-25.rounded-2
          div.d-flex.gap-3
            div.icon-shape.icon-md.bg-primary.text-white.rounded-2
              i.ti.ti-report-analytics.fs-4
            div
              h2.mb-3.fs-6 Total Sales
              h3.fw-bold.mb-0 $25,000
              p.text-primary.mb-0.small +5% since last month
      div.col-lg-3.col-12
        div.card.p-4.bg-success.bg-opacity-10.border.border-success.border-opacity-25.rounded-2
          div.d-flex.gap-3
            div.icon-shape.icon-md.bg-success.text-white.rounded-2
              i.ti.ti-repeat.fs-4
            div
              h2.mb-3.fs-6 Total Purchase
              h3.fw-bold.mb-0 $18,000
              p.text-success.mb-0.small +22% since last month
      div.col-lg-3.col-12
        div.card.p-4.bg-info.bg-opacity-10.border.border-info.border-opacity-25.rounded-2
          div.d-flex.gap-3
            div.icon-shape.icon-md.bg-info.text-white.rounded-2
              i.ti.ti-currency-dollar.fs-4
            div
              h2.mb-3.fs-6 Total Expenses
              h3.fw-bold.mb-0 $9,000
              p.text-info.mb-0.small +10% since last month
      div.col-lg-3.col-12
        div.card.p-4.bg-warning.bg-opacity-10.border.border-warning.border-opacity-25.rounded-2
          div.d-flex.gap-3
            div.icon-shape.icon-md.bg-warning.text-white.rounded-2
              i.ti.ti-notes.fs-4
            div
              h2.mb-3.fs-6 Invoice Due
              h3.fw-bold.mb-0 $25,000
              p.text-warning.mb-0.small +35% since last month

    div.row.g-3.mb-3
      div.col-lg-4.col-12
        div.card
          div.card-body.p-4
            div.d-flex.justify-content-between.border-bottom.pb-5.mb-3
              div
                h3.fw-bold.h4 $25,458
                span Total Profit
              div
                i.ti.ti-layers-subtract.fs-1.text-primary
            div.d-flex.justify-content-between.align-items-center.small
              div.text-muted
                span.text-success +35%
                |  vs Last Month
              div: a.link-primary.text-decoration-underline(href="#") View
      div.col-lg-4.col-12
        div.card
          div.card-body.p-4
            div.d-flex.justify-content-between.border-bottom.pb-5.mb-3
              div
                h3.fw-bold.h4 $45,458
                span Total Payment Returns
              div
                i.ti.ti-credit-card.fs-1.text-danger
            div.d-flex.justify-content-between.align-items-center.small
              div.text-muted
                span.text-danger -20%
                |  vs Last Month
              div: a.link-primary.text-decoration-underline(href="#") View
      div.col-lg-4.col-12
        div.card
          div.card-body.p-4
            div.d-flex.justify-content-between.border-bottom.pb-5.mb-3
              div
                h3.fw-bold.h4 $34,458
                span Total Expenses
              div
                i.ti.ti-cash-banknote.fs-1.text-warning
            div.d-flex.justify-content-between.align-items-center.small
              div.text-muted
                span.text-warning -20%
                |  vs Last Month
              div: a.link-primary.text-decoration-underline(href="#") View

    div.row.g-3.mb-3
      div.col-12.col-lg-6
        div.card
          div.card-header.d-flex.justify-content-between.align-items-center.bg-transparent.px-4.py-3
            h3.h5.mb-0 Sales vs Purchase
            div
              select.form-select.form-select-sm
                option(selected) This Year
                option This Month
                option This Week
          div.card-body.p-4
            #salesPurchaseChart
      div.col-12.col-lg-6
        div.card
          div.card-header.d-flex.justify-content-between.align-items-center.bg-transparent.px-4.py-3
            h3.h5.mb-0 Overall Information
            div
              select.form-select.form-select-sm
                option(selected) Last 6 Months
                option This Month
                option This Week
          div.card-body.p-4
            h3.h6 Customers Overview
            div.row.align-items-center
              div.col-sm-6
                #customerChart
              div.col-sm-6
                div.row
                  div.col-6.border-end
                    div.text-center
                      h2.mb-1 5.5K
                      p.text-success.mb-2 First Time
                      span.badge.bg-success
                        i.ti.ti-arrow-up-left.me-1
                        | 25%
                  div.col-6
                    div.text-center
                      h2.mb-1 3.5K
                      p.text-warning.mb-2 Return
                      span.badge.bg-success.badge-xs.d-inline-flex.align-items-center
                        i.ti.ti-arrow-up-left.me-1
                        | 21%
            div.row.text-center.border-top.mt-4.pt-4
              div.col-4.border-end
                h3.fw-bold.mb-2 6987
                small.text-secondary Suppliers
              div.col-4.border-end
                h3.fw-bold.mb-2 4896
                small.text-secondary Customers
              div.col-4
                h3.fw-bold.mb-2 487
                small.text-secondary Orders

    div.row.g-3
      // CARD 1 — Top Selling Products
      div.col-lg-4
        div.card.h-100
          div.card-header.bg-white.d-flex.justify-content-between.align-items-center.px-4.py-3
            h4.mb-0.h5 Top Selling Products
            button.btn.btn-sm.btn-outline-secondary
              i.ti.ti-calendar
              |  Today
          ul.list-group.list-group-flush
            li.list-group-item.d-flex.align-items-center.gap-3
              img.rounded(src="./assets/images/product-2.png", width="48")
              div.flex-grow-1
                p.mb-1 Wireless Earphones
                div.d-flex.align-items-center.gap-2.text-muted
                  small.fw-semibold $89
                  small •
                  small 1,250 Units
              span.badge.bg-danger-subtle.text-danger.border.border-danger 18%
            li.list-group-item.d-flex.align-items-center.gap-3
              img.rounded(src="./assets/images/product-1.png", width="48")
              div.flex-grow-1
                p.mb-1 Gaming Joy Stick
                div.d-flex.align-items-center.gap-2.text-muted
                  small.fw-semibold $49
                  small •
                  small 5,420 Units
              span.badge.bg-primary-subtle.text-primary.border.border-primary 32%
            li.list-group-item.d-flex.align-items-center.gap-3
              img.rounded(src="./assets/images/product-3.png", width="48")
              div.flex-grow-1
                p.mb-1 Smart Watch Pro
                div.d-flex.align-items-center.gap-2.text-muted
                  small.fw-semibold $98
                  small •
                  small 862 Units
              span.badge.bg-info-subtle.text-info.border.border-info 22%
            li.list-group-item.d-flex.align-items-center.gap-3
              img.rounded(src="./assets/images/product-4.png", width="48")
              div.flex-grow-1
                p.mb-1 USB-C Fast Charger
                div.d-flex.align-items-center.gap-2.text-muted
                  small.fw-semibold $35
                  small •
                  small 3,200 Units
              span.badge.bg-success-subtle.text-success.border.border-success 28%
            li.list-group-item.d-flex.align-items-center.gap-3
              img.rounded(src="./assets/images/product-5.png", width="48")
              div.flex-grow-1
                p.mb-1 Portable Bluetooth Speaker
                div.d-flex.align-items-center.gap-2.text-muted
                  small.fw-semibold $65
                  small •
                  small 2,890 Units
              span.badge.bg-warning-subtle.text-warning.border.border-warning 25%

      // CARD 2 — Low Stock Products
      div.col-lg-4
        div.card.h-100
          div.card-header.bg-white.d-flex.justify-content-between.align-items-center.px-4.py-3
            div.d-flex.align-items-center
              h4.mb-0.h5 Low Stock Products
            a.small.text-primary.text-decoration-underline(href="#") View All
          ul.list-group.list-group-flush
            li.list-group-item.d-flex.align-items-center.gap-3
              img.rounded(src="./assets/images/product-8.png", width="48")
              div.flex-grow-1
                p.mb-1 Wireless Headphones
                small ID: #554433
              div.d-flex.flex-column.gap-0.align-items-center
                span.fw-semibold.text-primary 06
                small.text-muted In Stock
            li.list-group-item.d-flex.align-items-center.gap-3
              img.rounded(src="./assets/images/product-4.png", width="48")
              div.flex-grow-1
                p.mb-1 USB-C Cable Pack
                small ID: #887766
              div.d-flex.flex-column.gap-0.align-items-center
                span.fw-semibold.text-primary 09
                small.text-muted In Stock
            li.list-group-item.d-flex.align-items-center.gap-3
              img.rounded(src="./assets/images/product-10.png", width="48")
              div.flex-grow-1
                p.mb-1 Phone Screen Protector
                small ID: #332211
              div.d-flex.flex-column.gap-0.align-items-center
                span.fw-semibold.text-primary 03
                small.text-muted In Stock
            li.list-group-item.d-flex.align-items-center.gap-3
              img.rounded(src="./assets/images/product-4.png", width="48")
              div.flex-grow-1
                p.mb-1 Portable Charger 20000mAh
                small ID: #998877
              div.d-flex.flex-column.gap-0.align-items-center
                span.fw-semibold.text-primary 07
                small.text-muted In Stock
            li.list-group-item.d-flex.align-items-center.gap-3
              img.rounded(src="./assets/images/product-6.png", width="48")
              div.flex-grow-1
                p.mb-1 Mechanical Keyboard RGB
                small ID: #665544
              div.d-flex.flex-column.gap-0.align-items-center
                span.fw-semibold.text-primary 02
                small.text-muted In Stock

      // CARD 3 — Recent Sales
      div.col-lg-4
        div.card.h-100
          div.card-header.bg-white.d-flex.justify-content-between.align-items-center.px-4.py-3
            h4.mb-0.h5 Recent Sales
            button.btn.btn-sm.btn-outline-secondary
              i.ti.ti-calendar-event
              |  Weekly
          ul.list-group.list-group-flush
            li.list-group-item.d-flex.align-items-center.gap-3
              img.rounded(src="./assets/images/product-7.png", width="48")
              div.flex-grow-1
                p.mb-1 MacBook Pro 16"
                div.d-flex.align-items-center.gap-2.text-muted
                  small.fw-semibold Computers
                  small •
                  small $2,499
              span.badge.bg-success-subtle.text-success Completed
            li.list-group-item.d-flex.align-items-center.gap-3
              img.rounded(src="./assets/images/product-9.png", width="48")
              div.flex-grow-1
                p.mb-1 AirPods Pro Max
                div.d-flex.align-items-center.gap-2.text-muted
                  small.fw-semibold Audio
                  small •
                  small $549
              span.badge.bg-primary-subtle.text-primary Processing
            li.list-group-item.d-flex.align-items-center.gap-3
              img.rounded(src="./assets/images/product-8.png", width="48")
              div.flex-grow-1
                p.mb-1 iPad Air 11"
                div.d-flex.align-items-center.gap-2.text-muted
                  small.fw-semibold Tablets
                  small •
                  small $799
              span.badge.bg-success-subtle.text-success Completed
            li.list-group-item.d-flex.align-items-center.gap-3
              img.rounded(src="./assets/images/product-3.png", width="48")
              div.flex-grow-1
                p.mb-1 Apple Watch Ultra
                div.d-flex.align-items-center.gap-2.text-muted
                  small.fw-semibold Wearables
                  small •
                  small $799
              span.badge.bg-warning-subtle.text-warning Pending
            li.list-group-item.d-flex.align-items-center.gap-3
              img.rounded(src="./assets/images/product-6.png", width="48")
              div.flex-grow-1
                p.mb-1 Magic Keyboard
                div.d-flex.align-items-center.gap-2.text-muted
                  small.fw-semibold Accessories
                  small •
                  small $299
              span.badge.bg-danger-subtle.text-danger Cancelled
